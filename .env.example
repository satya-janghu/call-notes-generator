# Basecamp OAuth Credentials
# Get these from https://launchpad.37signals.com/integrations
BASECAMP_CLIENT_ID=your-basecamp-client-id
BASECAMP_CLIENT_SECRET=your-basecamp-client-secret

# Auto-populated after OAuth flow (do not edit manually)
BASECAMP_ACCESS_TOKEN=
BASECAMP_REFRESH_TOKEN=
BASECAMP_TOKEN_EXPIRES_AT=

# Gemini API Key
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Model Configuration (optional - defaults shown)
GEMINI_SUMMARIZE_MODEL=gemini-2.5-flash
GEMINI_COMPILE_MODEL=gemini-2.5-pro

# Agency name used in AI prompts (optional, e.g. "Acme Digital")
AGENCY_NAME=

# Server Configuration (optional; the server binds to 127.0.0.1)
PORT=3000
